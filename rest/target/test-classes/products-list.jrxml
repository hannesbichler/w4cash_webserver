<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="products-list" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <parameter name="minPrice" class="java.lang.Double" isForPrompting="true">
        <defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[SELECT NAME, CODE, PRICESELL FROM PRODUCTS WHERE PRICESELL >= $P{minPrice} ORDER BY NAME]]>
    </queryString>

    <field name="NAME" class="java.lang.String"/>
    <field name="CODE" class="java.lang.String"/>
    <field name="PRICESELL" class="java.lang.Double"/>

    <title>
        <band height="40">
            <staticText>
                <reportElement x="0" y="0" width="535" height="30"/>
                <textElement>
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Product List]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="235" height="20"/>
                <text><![CDATA[Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="235" y="0" width="150" height="20"/>
                <text><![CDATA[Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="385" y="0" width="150" height="20"/>
                <text><![CDATA[Price]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="235" height="18"/>
                <textFieldExpression><![CDATA[$F{NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="235" y="0" width="150" height="18"/>
                <textFieldExpression><![CDATA[$F{CODE}]]></textFieldExpression>
            </textField>
            <textField pattern="0.00">
                <reportElement x="385" y="0" width="150" height="18"/>
                <textFieldExpression><![CDATA[$F{PRICESELL}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
